# -----------------------------
# DO NOT PUT SECRETS IN THIS FILE - IT IS COMMITTED TO SOURCE CONTROL
# LAIGO Project Configuration
# DO NOT PUT SECRETS IN THIS FILE - IT IS COMMITTED TO SOURCE CONTROL
# -----------------------------

#for Render hosting
HOST=0.0.0.0
PORT=8000

# Input/output directories
INPUT_DIR=./inputs
OUTPUT_DIR=./outputs

# Maximum number of parallel workers for image processing
MAX_WORKERS=2

# Maximum width of mosaic in blocks
MAX_MOSAIC_BLOCK_WIDTH=40

# how many studs are in a block length (the block is 16x16)
STUD_WIDTH_OF_BLOCK=16

# Job cleanup / retention
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL=300

# Font configuration (used for drawing step numbers)
DEFAULT_FONT=arial.ttf

# enable debug logging
DEBUG=True

LOG_FILE=laigoLOG.log
MAX_LOG_SIZE_MB=25

MAX_UPLOAD_SIZE_MB=250

FRONTEND_ORIGIN=https://laigo-frontend.onrender.com/

# ---- Order Optimizer ----
BRICKOWL_CACHE_TTL_SECONDS=3600
BRICKOWL_REQUEST_TIMEOUT_SECONDS=10
BRICKOWL_CONCURRENT_REQUEST_LIMIT=10
OPTIMIZER_MAX_STOCKOUT_RETRIES=2
LEGO_FALLBACK_TIMEOUT_SECONDS=90
SHIPPING_COUNTRY=US
SHIPPING_ZIP=
STRIPE_CURRENCY=usd
LAIGO_FEE_MIN_CENTS=300
LAIGO_FEE_PERCENT=5

# LEGO.com client
LEGO_SHIPPING_COST_CENTS=599        # $5.99 flat; LEGO.com charges once per order
LEGO_FREE_SHIPPING_THRESHOLD_CENTS=3500  # Orders >= $35.00 get free shipping
LEGO_MAX_QTY_PER_ITEM=9999

# BrickLink client (set to true once seller account + API keys are configured)
BRICKLINK_ENABLED=false

# ---- Checkout master gate (L0) ----
# CHECKOUT_ENABLED is the operator master switch. When false (or unset), the
# gate is closed regardless of every other condition (Stripe key present,
# Render env, etc.) and /confirm returns 503. Set to true once Stripe TEST
# credentials are wired AND you've reviewed §6 go-live checklist.
CHECKOUT_ENABLED=true

# ---- Database (Phase 9 — Neon Postgres migration) ----
# DB_BACKEND switches checkout_store + job lifecycle between the legacy
# JSON/in-memory path and Postgres. Default 'json' keeps the current
# behavior so dev without a provisioned Neon project still boots.
# Flip to 'postgres' at Phase F cutover (§9.3.11.11). Render env will
# override this; local dev keeps 'json' until you point at a Neon dev branch.
DB_BACKEND=postgres
# DATABASE_URL belongs in .env.secrets (gitignored) — Neon pooler DSN
# only (host suffix must contain '-pooler'). For local dev pointing at the
# Neon `dev` branch, use .env.local. See §9.4 step 1-2.
