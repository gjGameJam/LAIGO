# -----------------------------
# DO NOT PUT SECRETS IN THIS FILE - IT IS COMMITTED TO SOURCE CONTROL
# LAIGO Project Configuration
# DO NOT PUT SECRETS IN THIS FILE - IT IS COMMITTED TO SOURCE CONTROL
# -----------------------------

#for Render hosting
HOST=0.0.0.0
PORT=8000

# Input/output directories
INPUT_DIR=./inputs
OUTPUT_DIR=./outputs

# Maximum number of parallel workers for image processing.
# Keep at 1 unless on Render Standard tier (2 GB): each worker holds
# mediapipe+numpy+PIL (~400-550 MB RSS). See CLAUDE.md "Configuration" + D-028.
MAX_WORKERS=1

# Max pending jobs before /generate returns 429.
MAX_QUEUE_SIZE=20

# Maximum width of mosaic in blocks
MAX_MOSAIC_BLOCK_WIDTH=40

# NOTE: STUD_WIDTH_OF_BLOCK was removed (D-035). The 16-stud block is a fixed
# structural constant (scripts/mosaic_types.py: STUDS_PER_BLOCK) — the baseplate
# art and per-column plate geometry are hand-built for 16x16, so it was never a
# safe runtime knob. Setting this var now has no effect.

# Max long-edge (px) the input image is downscaled to before the heavy full-res
# ops (LAB lightness round-trip, MediaPipe). The mosaic output is <=640 studs, so
# 2048 oversamples it >3x (no perceptible quality change) while bounding the
# float64 arrays that OOM'd the worker on multi-megapixel uploads. See D-012.
MAX_PROCESSING_DIMENSION=2048

# Job cleanup / retention
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL=300

# Font configuration (used for drawing step numbers)
DEFAULT_FONT=arial.ttf

# enable debug logging
DEBUG=True

LOG_FILE=laigoLOG.log
MAX_LOG_SIZE_MB=25

MAX_UPLOAD_SIZE_MB=250

FRONTEND_ORIGIN=https://laigo-frontend.onrender.com/

# ---- Order Optimizer ----
BRICKOWL_CACHE_TTL_SECONDS=3600
BRICKOWL_REQUEST_TIMEOUT_SECONDS=10
BRICKOWL_CONCURRENT_REQUEST_LIMIT=10
OPTIMIZER_MAX_STOCKOUT_RETRIES=2
LEGO_FALLBACK_TIMEOUT_SECONDS=90
SHIPPING_COUNTRY=US
SHIPPING_ZIP=
STRIPE_CURRENCY=usd
LAIGO_FEE_MIN_CENTS=300
LAIGO_FEE_PERCENT=5

# LEGO.com client
LEGO_SHIPPING_COST_CENTS=599        # $5.99 flat; LEGO.com charges once per order
LEGO_FREE_SHIPPING_THRESHOLD_CENTS=3500  # Orders >= $35.00 get free shipping
LEGO_MAX_QTY_PER_ITEM=9999

# BrickLink client (set to true once seller account + API keys are configured)
BRICKLINK_ENABLED=false

# ---- Checkout master gate (L0) ----
# CHECKOUT_ENABLED is the operator master switch for the SHELVED checkout saga
# (hold → marketplace order → capture). Kept false in the pay-what-you-want
# model — the new /jobs/{id}/pay endpoint does not consult this gate; it checks
# the payment registry directly. Leaving this true while DB_BACKEND=json would
# also trip the B47 boot refusal.
CHECKOUT_ENABLED=false

# ---- Build-pack email (Resend) ----
# After a PWYW checkout ($0 or paid), scripts/emailer.py emails the build pack
# (instructions PDF + order list) to the address the customer entered in the
# pay modal. RESEND_API_KEY belongs in .env.secrets (gitignored) / the Render
# env — with EMAIL_ENABLED=true and no key, sends are skipped with a warning.
EMAIL_ENABLED=true
# Sender identity. onboarding@resend.dev is Resend's dev-mode sender: it only
# delivers to the Resend account owner's own address. Switching to production
# = verify a custom domain in Resend (SPF+DKIM DNS) and change ONLY this var,
# e.g. "LAIGO <builds@yourdomain.com>". No code change.
EMAIL_FROM=LAIGO <onboarding@resend.dev>
# Public origin used to build the /jobs/{id}/download link inside the email
# (needed when the pack is too big to attach). Leave empty on Render — the
# auto-set RENDER_EXTERNAL_URL is the fallback. Set explicitly for other hosts
# or when testing link emails locally (e.g. http://127.0.0.1:8000).
PUBLIC_API_BASE_URL=

# ---- Database ----
# DB_BACKEND switches the job lifecycle (and the shelved checkout_store) between
# the JSON/in-memory path and Postgres. Reverted to 'json' alongside the
# pay-what-you-want pivot: the Postgres-only saga/reconcile/holds machinery is
# shelved, so the in-memory JSON jobs store is sufficient (job metadata is lost
# on restart; completed artifacts persist on disk). 'json' also makes init_pool
# / verify_schema / resume_in_flight_sagas / start_reconcile_task all no-op.
DB_BACKEND=json
# DATABASE_URL belongs in .env.secrets (gitignored) — Neon pooler DSN
# only (host suffix must contain '-pooler'). For local dev pointing at the
# Neon `dev` branch, use .env.local. See §9.4 step 1-2.
